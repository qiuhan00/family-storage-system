# 家庭收纳物品管理系统 —— 环境变量钥匙模板
# 复制为 .env 并填入真实值；真实值绝不允许提交到仓库。
# 生产启动时经 start.sh / systemd EnvironmentFile 注入后端进程。

# MySQL 连接 URL（prod profile 必填）
# 示例：jdbc:mysql://db.example.com:3306/family_storage?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_URL=jdbc:mysql://localhost:3306/family_storage?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai

# MySQL 口令（prod profile 必填，start.sh 校验非空才启动）
DB_PASSWORD=

# JWT 签名密钥（prod profile 必填，start.sh 校验非空才启动）
# 生产必须使用 >=32 字节的强随机串，例如：openssl rand -base64 48
JWT_SECRET=

# 上传文件根目录（可选，默认 ./uploads）
# 建议与 nginx 配置中 location /uploads 的 alias 保持一致。
UPLOAD_DIR=./uploads